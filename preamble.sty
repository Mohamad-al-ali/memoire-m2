% Drafting marker: highlights what is still to be done or to be checked.
% Set \todoitemsoff in main.tex to hide every marker in the final version.
\newcommand{\todoitem}[1]{\textcolor{red}{\textbf{[TODO:} #1\textbf{]}}}
\newcommand{\todoitemsoff}{\renewcommand{\todoitem}[1]{}}

% Supervisor annotations: text written on top of the student's draft, shown in
% colour so it is obvious who wrote what.
%
%   \add{...}            text added by the supervisor            (blue)
%   \add[teal]{...}      same, in any xcolor colour name
%   \del{...}            text to remove, struck through          (red)
%   \replace{old}{new}   struck-through old, followed by the new text
%   \note{...}           side remark, not part of the text       (orange)
%
%   \annotationsplain    accept everything: keep the added and replacement
%                        text in normal black, drop what is struck through,
%                        keep the \note remarks as plain text
%   \annotationsoff      same, but drop the \note remarks as well
%
% Put \annotationsoff (and \todoitemsoff) right after \begin{document} to
% produce a clean version for the jury.
\definecolor{addcolour}{HTML}{0B5FA5}
\definecolor{delcolour}{HTML}{A11616}
\definecolor{notecolour}{HTML}{B35C00}

\newcommand{\add}[2][addcolour]{\textcolor{#1}{#2}}
\newcommand{\del}[1]{\textcolor{delcolour}{\sout{#1}}}
\newcommand{\replace}[2]{\del{#1}\ \add{#2}}
\newcommand{\note}[2][notecolour]{\textcolor{#1}{\small$\blacktriangleright$\,\textit{#2}}}

% \begin{cut} ... \end{cut} removes a whole passage. Use it instead of \del
% when the text spans several paragraphs or contains macros such as \SI or
% \todoitem: \del strikes text through with \sout, which cannot cope with
% either. The passage is shown in colour but not struck through.
\newenvironment{cut}%
    {\par\color{delcolour}\itshape[cut]\ \ignorespaces}%
    {\par}

\newcommand{\annotationsplain}{%
    \renewcommand{\add}[2][]{##2}%
    \renewcommand{\del}[1]{}%
    \renewcommand{\replace}[2]{##2}%
    \renewcommand{\note}[2][]{##2}%
    \renewenvironment{cut}{\setbox0=\vbox\bgroup}{\egroup}%
}
\newcommand{\annotationsoff}{%
    \renewcommand{\add}[2][]{##2}%
    \renewcommand{\del}[1]{}%
    \renewcommand{\replace}[2]{##2}%
    \renewcommand{\note}[2][]{}%
    \renewenvironment{cut}{\setbox0=\vbox\bgroup}{\egroup}%
}

\newcommand{\pfrac}[2]{\dfrac{\partial #1}{\partial #2}}
\newcommand{\diffrac}[2]{\dfrac{d #1}{d #2}}

